{
  "name": "p4fnv",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "npm run icons && tauri dev",
    "dev:web": "vite --port 1420",
    "build": "npm run build:agent && npm run build:app",
    "build:agent": "tsc -p tools/p4fnv-agent/tsconfig.json",
    "build:app": "npm run icons && tauri build --no-bundle && node scripts/copy-locales.mjs",
    "build:fast": "npm run icons && tauri build --debug --no-bundle",
    "build:release-fast": "npm run icons && tauri build --no-bundle -- --profile release-fast",
    "build:portable": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "setup:release-tools": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/install-release-tools.ps1",
    "verify:versions": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/verify-version.ps1",
    "build:web": "tsc --noEmit && vite build",
    "icons": "node scripts/sync-icons.mjs",
    "mcp:agent": ".\\.toolchain\\node\\node.exe tools\\p4fnv-agent\\start.mjs",
    "smoke:agent": "npm run build:agent && .\\.toolchain\\node\\node.exe tools\\p4fnv-agent\\dist\\smoke.js",
    "test": "vitest run",
    "test:workflow": "vitest run tools/parallel-workflow/workflow.test.mjs",
    "test:watch": "vitest",
    "tauri": "tauri",
    "workflow": "node tools/parallel-workflow/workflow.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "lucide-react": "1.27.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
