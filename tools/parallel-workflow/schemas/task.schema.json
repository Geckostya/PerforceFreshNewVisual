{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4fnv.local/schemas/parallel-workflow/task.schema.json",
  "title": "P4FNV parallel workflow task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "description",
    "priority",
    "dependsOn",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer", "minimum": 1, "maximum": 999 },
    "taskKind": {
      "enum": ["feature", "refactor", "stabilization"]
    },
    "workClass": {
      "enum": ["implementation", "mechanical", "quality", "complex"]
    },
    "agentProfile": { "$ref": "#/$defs/agentProfile" },
    "actualAgentProfile": { "$ref": "#/$defs/actualAgentProfile" },
    "agentBudget": { "$ref": "#/$defs/agentBudget" },
    "agentAvailability": { "$ref": "#/$defs/agentAvailability" },
    "reasoningEffort": { "enum": ["low", "medium", "high"] },
    "qualityWeight": { "type": "number", "minimum": 0, "maximum": 2 },
    "maxChildAgents": { "const": 0 },
    "resourceJustification": { "type": "string", "minLength": 1 },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "coveredFeatureTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "qualityCheckpointId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "baseRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "validationProfile": {
      "enum": [
        "p4fnv-auto",
        "p4fnv-docs",
        "p4fnv-frontend",
        "p4fnv-rust",
        "p4fnv-fast",
        "p4fnv-full",
        "p4fnv-full-p4d"
      ]
    },
    "resolvedValidationProfile": {
      "enum": [
        "p4fnv-docs",
        "p4fnv-frontend",
        "p4fnv-rust",
        "p4fnv-fast",
        "p4fnv-full",
        "p4fnv-full-p4d"
      ]
    },
    "worktreePath": { "type": "string", "minLength": 1 },
    "relevantPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "metadata": { "type": "object" },
    "status": {
      "enum": ["pending", "active", "completed", "blocked"]
    },
    "attempt": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "workerThreadId": { "type": "string", "minLength": 1 },
    "assignmentId": { "type": "string", "minLength": 1 },
    "baseSha": { "$ref": "#/$defs/commitSha" },
    "claimedAt": { "type": "string", "format": "date-time" },
    "latestValidationRequestId": { "type": "string", "minLength": 1 },
    "latestValidationState": {
      "enum": ["pending", "passed", "failed", "infrastructure-error"]
    },
    "latestValidationResultId": { "type": "string", "minLength": 1 },
    "latestValidatedCommitSha": { "$ref": "#/$defs/commitSha" },
    "validatedCommitSha": { "$ref": "#/$defs/commitSha" },
    "validationResultId": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "format": "date-time" },
    "blockedReason": { "type": "string", "minLength": 1 },
    "blockedAt": { "type": "string", "format": "date-time" },
    "requeueReason": { "type": "string", "minLength": 1 },
    "requeuedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "agentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoningEffort", "maximumReasoningEffort"],
      "properties": {
        "model": { "enum": ["terra", "luna", "sol"] },
        "reasoningEffort": { "enum": ["low", "medium", "high"] },
        "maximumReasoningEffort": { "enum": ["low", "medium", "high"] }
      }
    },
    "actualAgentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoningEffort"],
      "properties": {
        "model": { "enum": ["terra", "luna", "sol"] },
        "reasoningEffort": { "enum": ["low", "medium", "high"] }
      }
    },
    "agentBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChildAgents", "monitorTimeoutMs", "maximumMonitorTimeoutMs"],
      "properties": {
        "maxChildAgents": { "const": 0 },
        "monitorTimeoutMs": { "type": "integer", "minimum": 60000 },
        "maximumMonitorTimeoutMs": { "type": "integer", "minimum": 60000 }
      }
    },
    "agentAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "status"],
      "properties": {
        "model": { "enum": ["terra", "luna", "sol"] },
        "status": { "enum": ["available", "unavailable", "unchecked"] }
      }
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    }
  }
}
