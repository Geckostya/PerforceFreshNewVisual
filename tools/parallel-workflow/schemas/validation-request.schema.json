{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4fnv.local/schemas/parallel-workflow/validation-request.schema.json",
  "title": "P4FNV validation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "workflowId",
    "taskId",
    "taskKind",
    "taskPriority",
    "assignmentId",
    "workerThreadId",
    "worktreePath",
    "commitSha",
    "baseSha",
    "validationProfile",
    "changedFiles",
    "summary",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "taskKind": {
      "enum": ["feature", "refactor", "stabilization"]
    },
    "qualityCheckpointId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "taskPriority": { "type": "integer", "minimum": 1, "maximum": 999 },
    "assignmentId": { "type": "string", "minLength": 1 },
    "workerThreadId": { "type": "string", "minLength": 1 },
    "worktreePath": { "type": "string", "minLength": 1 },
    "commitSha": { "$ref": "#/$defs/commitSha" },
    "baseSha": { "$ref": "#/$defs/commitSha" },
    "validationProfile": {
      "enum": ["p4fnv-fast", "p4fnv-full", "p4fnv-full-p4d"]
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": { "type": "string" },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    }
  }
}
